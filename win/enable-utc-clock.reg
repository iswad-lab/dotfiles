Windows Registry Editor Version 5.00

; =============================================================================
;  Make Windows use UTC for the hardware clock (RTC)
; =============================================================================
;  Why:  Linux keeps the RTC in UTC (see /etc/adjtime -> "UTC").
;        Windows 11 defaults to local time for the RTC, so every time you
;        switch OS the clock drifts until the next internet sync.
;
;  Usage:
;     1. Double-click this file and confirm (run as Administrator).
;     2. Reboot into Windows once.
;
;  To undo:  delete the "RealTimeIsUniversal" value below, then reboot.
;
;  Only touch this on the Windows side. Linux is already configured (UTC).
; =============================================================================

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\TimeZoneInformation]
"RealTimeIsUniversal"=dword:00000001
