#!/bin/bash
# ryzenadj-profile - CPU/GPU power profiles for AC/battery on Ryzen 5800H
set -u

log() { logger -t "ryzenadj-profile" "$@"; }

GPU_AC=1800
GPU_BAT=900
TDP_AC=25000
TDP_BAT=20000
TEMP_AC=85
TEMP_BAT=75
FAST_AC=30000
FAST_BAT=25000
FREQ_AC=3200000
FREQ_BAT=3200000

apply_ac() {
    log "AC profile: 3.2 GHz / ${TDP_AC}W / GPU ${GPU_AC} MHz"
    echo powersave | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor
    echo "${FREQ_AC}" | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq
    ryzenadj --stapm-limit=${TDP_AC} --fast-limit=${FAST_AC} --slow-limit=${TDP_AC} \
             --apu-slow-limit=30000 --tctl-temp=${TEMP_AC}
    nvidia-smi -lgc 0,${GPU_AC} 2>/dev/null || true
    nvidia-smi -lmc 405 2>/dev/null || true
    log "OK: CPU 3.2 GHz / ${TDP_AC}W, GPU ${GPU_AC} MHz"
}

apply_battery() {
    log "Battery profile: 3.2 GHz / ${TDP_BAT}W / GPU ${GPU_BAT} MHz"
    echo powersave | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor
    echo "${FREQ_BAT}" | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq
    ryzenadj --stapm-limit=${TDP_BAT} --fast-limit=${FAST_BAT} --slow-limit=${TDP_BAT} \
             --apu-slow-limit=15000 --tctl-temp=${TEMP_BAT}
    nvidia-smi -lgc 0,${GPU_BAT} 2>/dev/null || true
    nvidia-smi -lmc 405 2>/dev/null || true
    log "OK: CPU 3.2 GHz / ${TDP_BAT}W, GPU ${GPU_BAT} MHz"
}

case "${1:-auto}" in
    ac|secteur)  apply_ac  ;;
    battery|batterie)  apply_battery  ;;
    auto)
        online=$(cat /sys/class/power_supply/ACAD/online 2>/dev/null || echo 0)
        [ "$online" = "1" ] && apply_ac || apply_battery
        ;;
    info)
        # Collect data
        gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)
        freq_khz=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null)
        freq_ghz=$(awk "BEGIN { printf \"%.2f\", $freq_khz / 1000000 }" 2>/dev/null)

        temp_cpu=$(sensors 2>/dev/null | grep -E "^Tctl" | awk '{print $2}' | tr -d '+')
        temp_igpu=$(sensors 2>/dev/null | grep -E "^edge" | awk '{print $2}' | tr -d '+')

        # Display
        echo "┌────────────────────────────────────────────┐"
        printf "│ %-42s │\n" "Ryzen 5800H — Power Profile"
        echo "├────────────────────────────────────────────┤"
        printf "│ CPU          │ %-26s │\n" "$gov @ ${freq_ghz}GHz"

        limits=$(ryzenadj --info 2>/dev/null | grep -E "STAPM|PPT" | head -6)
        while IFS='|' read -r raw; do
            label=$(echo "$raw" | awk -F'|' '{print $2}' | xargs | sed 's/ LIMIT//;s/ VALUE//')
            val=$(echo "$raw" | awk -F'|' '{print $3}' | xargs)
            [ -n "$label" ] && printf "│ %-12s │ %s W        │\n" "$label" "$val"
        done <<< "$limits"

        echo "├────────────────────────────────────────────┤"

        [ -n "$temp_cpu" ] && printf "│ %-12s │ %-26s │\n" "CPU temp" "$temp_cpu"
        [ -n "$temp_igpu" ] && printf "│ %-12s │ %-26s │\n" "iGPU temp" "$temp_igpu"

        # NVIDIA (skip if unavailable — VFIO or iGPU mode)
        nvidia=""
        nvidia=$(nvidia-smi --query-gpu=temperature.gpu,power.draw --format=csv,noheader 2>/dev/null) || true
        if echo "$nvidia" | grep -qP '^\d+'; then
            echo "├────────────────────────────────────────────┤"
            nvidia_temp=$(echo "$nvidia" | awk -F', ' '{print $1}')
            nvidia_pwr=$(echo "$nvidia" | awk -F', ' '{print $2}')
            printf "│ dGPU temp   │ %-26s │\n" "${nvidia_temp}°C"
            printf "│ dGPU power  │ %-26s │\n" "$nvidia_pwr"
        fi

        echo "├────────────────────────────────────────────┤"

        nbfc_data=$(nbfc status 2>/dev/null) || true
        sys_temp=$(echo "$nbfc_data" | awk -F': ' '/Temperature/{t=$2} END{print t}')
        fan_speed=$(echo "$nbfc_data" | awk -F': ' '/Current Fan Speed/{s=$2} END{print s}')
        [ -n "$sys_temp" ] && printf "│ %-12s │ %-26s │\n" "System temp" "$sys_temp"
        [ -n "$fan_speed" ] && printf "│ %-12s │ %-26s │\n" "Fans speed" "$fan_speed"

        echo "└────────────────────────────────────────────┘"
        ;;
    *)
        echo "Usage: $0 {ac|battery|auto|info}"
        exit 1
        ;;
esac
