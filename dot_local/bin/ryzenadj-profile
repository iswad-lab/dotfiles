#!/bin/bash
# ryzenadj-profile - CPU/GPU power profiles for AC/battery on Ryzen 5800H
set -euo pipefail

log() { logger -t "ryzenadj-profile" "$@"; }

# ------ Settings ------
GPU_AC=1800
GPU_BAT=900
TDP_AC=25000
TDP_BAT=20000
TEMP_AC=85
TEMP_BAT=75
FAST_AC=30000
FAST_BAT=25000
FREQ_AC=3200000
FREQ_BAT=3200000

apply_ac() {
    log "AC profile: 3.2 GHz / ${TDP_AC}W / GPU ${GPU_AC} MHz"
    echo powersave | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor
    echo "${FREQ_AC}" | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq
    ryzenadj --stapm-limit=${TDP_AC} --fast-limit=${FAST_AC} --slow-limit=${TDP_AC} \
             --apu-slow-limit=30000 --tctl-temp=${TEMP_AC}
    nvidia-smi -lgc 0,${GPU_AC} 2>/dev/null || true
    nvidia-smi -lmc 405 2>/dev/null || true
    log "OK: CPU 3.2 GHz / ${TDP_AC}W, GPU ${GPU_AC} MHz"
}

apply_battery() {
    log "Battery profile: 3.2 GHz / ${TDP_BAT}W / GPU ${GPU_BAT} MHz"
    echo powersave | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor
    echo "${FREQ_BAT}" | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq
    ryzenadj --stapm-limit=${TDP_BAT} --fast-limit=${FAST_BAT} --slow-limit=${TDP_BAT} \
             --apu-slow-limit=15000 --tctl-temp=${TEMP_BAT}
    nvidia-smi -lgc 0,${GPU_BAT} 2>/dev/null || true
    nvidia-smi -lmc 405 2>/dev/null || true
    log "OK: CPU 3.2 GHz / ${TDP_BAT}W, GPU ${GPU_BAT} MHz"
}

case "${1:-auto}" in
    ac|secteur)  apply_ac  ;;
    battery|batterie)  apply_battery  ;;
    auto)
        online=$(cat /sys/class/power_supply/ACAD/online 2>/dev/null || echo 0)
        [ "$online" = "1" ] && apply_ac || apply_battery
        ;;
    info)
        echo "Governor:"
        cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
        echo "Max freq:"
        cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
        echo "Ryzenadj:"
        ryzenadj --info 2>/dev/null | grep -E "LIMIT|VALUE" | head -8
        echo "GPU:"
        nvidia-smi --query-gpu=temperature.gpu,power.draw,clocks.current.graphics,pstate --format=csv 2>/dev/null || echo "(VFIO / unavailable)"
        echo "NBFC:"
        nbfc status 2>/dev/null | grep -E "Fan Speed|Temperature|Critical" | head -6
        ;;
    *)
        echo "Usage: $0 {ac|battery|auto|info}"
        exit 1
        ;;
esac
