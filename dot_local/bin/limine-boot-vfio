#!/bin/bash
# One-time boot to VFIO (GPU passthrough) kernel entry

LIMINE_CONF="/boot/limine.conf"

ENTRY=$(sed -n '/linux-cachyos-vfio/q;p' "$LIMINE_CONF" | grep -cP '^\s*/{2,}')

if [ "$ENTRY" -eq 0 ] 2>/dev/null; then
  echo "VFIO entry not found in $LIMINE_CONF"
  exit 1
fi

sudo sed -i "s/^default_entry: [0-9]*/default_entry: $ENTRY/" "$LIMINE_CONF"
echo "Booting VFIO passthrough kernel (entry $ENTRY)..."
sudo reboot
