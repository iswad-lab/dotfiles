#!/bin/bash
# Helper: set Limine one-time boot entry (EFI variable + default_entry)
LIMINE_CONF="/boot/limine.conf"
EFIVAR_PATH="/sys/firmware/efi/efivars/LimineLastBootedEntry-513ee0d0-6e43-cb05-b272-f146a2fcb88a"

set_entry() {
  local entry_name="$1"
  local entry_index="${2:-0}"

  # Set default_entry in config
  sudo sed -i "s/^default_entry: [0-9]*/default_entry: $entry_index/" "$LIMINE_CONF"

  # Override EFI variable (honored by remember_last_entry)
  # Python os.write works reliably with efivarfs (printf|dd does not)
  python3 -c "
import os
data = b'\\x07\\x00\\x00\\x00' + b'$entry_name\\x00'
fd = os.open('$EFIVAR_PATH', os.O_WRONLY)
os.write(fd, data)
os.close(fd)
" 2>/dev/null || {
    # Fallback: try with chmod if immutable
    sudo chattr -i "$EFIVAR_PATH" 2>/dev/null
    python3 -c "
import os
data = b'\\x07\\x00\\x00\\x00' + b'$entry_name\\x00'
fd = os.open('$EFIVAR_PATH', os.O_WRONLY)
os.write(fd, data)
os.close(fd)
" 2>/dev/null
  }

  echo "Booting: $entry_name (entry $entry_index)..."
  sudo reboot
}
