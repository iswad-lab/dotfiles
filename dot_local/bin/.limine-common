#!/bin/bash
# Helper: set Limine boot entry (handles remember_last_entry + default_entry)
# Usage: set-limine-entry "Entry Name" [index]

LIMINE_CONF="/boot/limine.conf"
EFIVAR_PATH=$(sudo find /sys/firmware/efi/efivars -name "LimineLastBootedEntry-*" 2>/dev/null | head -1)

set_entry() {
  local entry_name="$1"
  local entry_index="${2:-0}"

  # Set default_entry in config
  sudo sed -i "s/^default_entry: [0-9]*/default_entry: $entry_index/" "$LIMINE_CONF"

  # Override EFI variable (remember_last_entry)
  if [ -n "$EFIVAR_PATH" ] && [ -w "$EFIVAR_PATH" ]; then
    # Remove immutable flag, write, re-add
    sudo chattr -i "$EFIVAR_PATH" 2>/dev/null
    printf '\x07\x00\x00\x00%s\x00' "CachyOS/$entry_name" | sudo dd of="$EFIVAR_PATH" bs=1 status=none 2>/dev/null
    sudo chattr +i "$EFIVAR_PATH" 2>/dev/null
  fi

  echo "Booting: $entry_name (entry $entry_index)..."
  sudo reboot
}
