#!/bin/bash
# Helper: set Limine one-time boot entry via efibootmgr
# Uses UEFI BootNext for one-time boot (more reliable than Limine config)

set_entry() {
  local entry_name="$1"
  local efi_boot_id="$2"

  if [ -z "$efi_boot_id" ]; then
    echo "ERROR: EFI boot ID not specified"
    exit 1
  fi

  sudo efibootmgr --bootnext "$efi_boot_id" > /dev/null 2>&1

  echo "Booting: $entry_name (BootNext $efi_boot_id)..."
  sudo reboot
}
