#!/bin/bash
# One-time boot to default Linux kernel (linux-cachyos)
LIMINE_CONF="/boot/limine.conf"

if ! sudo grep -qm1 'linux-cachyos' "$LIMINE_CONF"; then
  echo "Linux entry not found in $LIMINE_CONF"
  exit 1
fi

# Find entry index by counting // entries before "//linux-cachyos" (exact match)
ENTRY=$(sudo sed -n '/^\s*\/\/linux-cachyos$/q;p' "$LIMINE_CONF" | grep -cP '^\s*//[^/]')

# Set Limine default + EFI var
sudo sed -i "s/^default_entry: [0-9]*/default_entry: $ENTRY/" "$LIMINE_CONF"
EFIVAR_PATH="/sys/firmware/efi/efivars/LimineLastBootedEntry-513ee0d0-6e43-cb05-b272-f146a2fcb88a"
sudo chattr -i "$EFIVAR_PATH" 2>/dev/null
sudo /usr/bin/python3 -c "
import os
os.write(os.open('$EFIVAR_PATH', os.O_WRONLY), b'\x07\x00\x00\x00CachyOS/linux-cachyos\x00')
" 2>/dev/null

# Boot Limine via UEFI BootNext
sudo efibootmgr --bootnext 0006 > /dev/null 2>&1
echo "Booting Linux (entry $ENTRY)..."
sudo reboot
