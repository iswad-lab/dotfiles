# =============================================================================
# packages.pacman — official repository packages
# Installed via: run_once_01-packages.sh
# CachyOS+KDE already installed — this file manages the delta only
# =============================================================================

# --- GPU NVIDIA + AMD (pas de mode-switching : le dGPU pilote l'écran) --------
libva-nvidia-driver         # VA-API hardware acceleration for NVIDIA (Wayland)
lib32-nvidia-utils          # 32-bit NVIDIA layer (Wine, Steam)
opencl-nvidia               # NVIDIA compute
lib32-opencl-nvidia
vulkan-radeon               # AMD iGPU
lib32-vulkan-radeon
lib32-vulkan-icd-loader

# --- Pipewire audio (pipewire-jack replaces jack2 via script) ----------------
pipewire-jack               # JACK interface over pipewire
lib32-pipewire-jack         # 32-bit layer for yabridge (32-bit VST)

# --- Pro Audio ---------------------------------------------------------------
reaper
reapack
sws
yabridge                    # Windows VST bridge (prebuilt, Wine-version agnostic)
yabridgectl                 # yabridge management utility
# wine-staging 9.21 — standalone runner (via run_once_02-wine-staging.sh)
winetricks
qpwgraph
easyeffects
realtime-privileges
rtirq
lsp-plugins                    # CLAP + VST3 + LV2 (meta-paquet)

# --- Monitoring --------------------------------------------------------------
btop
nvtop

# --- Network & Security ------------------------------------------------------
openssh
samba                       # winbind (ntlm_auth) pour Wine - requis par certains plugins VST
ufw
proton-vpn-cli

# --- System ------------------------------------------------------------------
snapper
btrfs-assistant
cpupower
fwupd
rsync
ripgrep
duf                         # better df
fastfetch                   # system info
plocate                     # fast file search
downgrade                   # rollback packages (Arch lifesaver)

# --- AMD Hardware ------------------------------------------------------------
amd-ucode                   # AMD processor microcode
acpi_call-dkms              # battery/chassis ACPI calls (provides acpi_call)
# ryzenadj → AUR

# --- Virtualization ----------------------------------------------------------
qemu-desktop
virt-manager
podman
distrobox
libvirt
dnsmasq
vde2
openbsd-netcat
swtpm
edk2-ovmf

# --- Dev ---------------------------------------------------------------------
git
github-cli
python-pip
python-virtualenv

# --- Applications ------------------------------------------------------------
firefox
zed
blender
obs-studio
obsidian
bitwarden                   # password manager
bitwarden-cli               # CLI vault (SSH keys, backup)
localsend                   # AirDrop-like file sharing
# davinci-resolve             # optional, validate before deploying
